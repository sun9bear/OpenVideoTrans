# /etc/ovt/worker.env — media-worker bootstrap env (chmod 600 root:root).
# ONLY bootstrap values live here. R2 credentials and free-provider keys are pulled from the
# control plane at startup over TLS + this bearer, and held in MEMORY only (SECRETS unit) —
# never written to this file or the box's disk.

# Control plane origin (https enforced by the worker outside localhost).
OVT_CONTROL_PLANE_URL=https://example.com

# Worker bearer for /internal/* (wrangler secret INTERNAL_TOKEN). For zero-downtime rotation set
# OVT_INTERNAL_TOKEN_NEXT alongside, roll the fleet, then promote (runbook §rotation).
OVT_INTERNAL_TOKEN=set-me
#OVT_INTERNAL_TOKEN_NEXT=

# 4GB box baseline (backlog §3): one heavy job; the light-slot reserve keeps a subtitle-only
# slot available under load (M2-CLOSE PR-D scheduling).
OVT_WORKER_CONCURRENCY=1
OVT_LIGHT_SLOT_RESERVE=1
