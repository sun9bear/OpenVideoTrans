{
  // Control-plane Cloudflare Worker — deploy config (T2.1). NOT used by the vitest gate; the real
  // resource ids + secrets are wired by the DEPLOY unit. NO SECRETS LIVE HERE: the R2 S3 presign
  // credentials (R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY) are `wrangler secret put`, and the free
  // provider keys are gated to the SECRETS unit — this file references binding/var NAMES only.
  "name": "ovt-control-plane",
  "main": "src/index.ts",
  // Serve the Worker (API + same-origin SPA) on the owner's independent domain (AD-15). custom_domain
  // makes wrangler create the DNS record + edge cert for the apex on deploy (zone is in this account).
  // This is ALSO the go-live domain binding — the SPA + /api are same-origin here, so no CORS surface.
  "routes": [{ "pattern": "openvideotrans.xyz", "custom_domain": true }],
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // DEPLOY (#28): the SAME Worker serves the SPA (same-origin — the posture App.svelte assumes; no
  // CORS surface, SameSite=Strict anon cookie stays first-party). Static requests are answered from
  // the built bundle; run_worker_first keeps the API + cron + queue paths in Worker code. Build the
  // SPA first (pnpm --filter @open-video-trans/web build) — wrangler uploads apps/web/dist verbatim.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  // T2.3 sweeper cadence — CF Cron Triggers are OMITTED at launch: the account's schedules API
  // rejected the trigger deploy (free-tier / entitlement), so the sweeper is driven externally
  // instead by .github/workflows/sweep.yml (scheduled) hitting POST /internal/admin/sweep with the
  // admin token. The scheduled() handler stays in src/index.ts (dormant with no cron bound); re-add
  // `"triggers": { "crons": ["* * * * *"] }` here if the account later supports cron triggers.
  // Resources pre-created on the owner's independent CF account (2026-06-21); wired 2026-07-03.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ovt-db",
      "database_id": "49afb39a-8386-40b2-b15e-a273b5c2bfb8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ovt-artifacts" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "f06aa6bcf0e642ff91da834e47be219c" }],
  // Owner-provided secrets live in the account Secrets Store (scope: Workers), NOT as plain wrangler
  // secrets — so bind them here and resolveSecrets() (core.ts, at each entry) turns them into the
  // plain env strings the code reads. store_id = the account Secrets Store. The self-generated
  // INTERNAL_TOKEN / ADMIN_TOKEN / ANON_ID_HMAC_KEY are plain `wrangler secret put` secrets (injected
  // by the deploy `secrets` step) and need no binding here. ASSEMBLYAI_API_KEY is intentionally NOT
  // bound: it is a PAID provider and never used by the free-pool routing (red line).
  "secrets_store_secrets": [
    { "binding": "SS_R2_ACCESS_KEY_ID", "store_id": "78d1fc96c03044c2bf20f9dce7a47340", "secret_name": "R2_ACCESS_KEY_ID" },
    { "binding": "SS_R2_SECRET_ACCESS_KEY", "store_id": "78d1fc96c03044c2bf20f9dce7a47340", "secret_name": "R2_SECRET_ACCESS_KEY" },
    { "binding": "SS_DEEPL_API_KEY", "store_id": "78d1fc96c03044c2bf20f9dce7a47340", "secret_name": "DEEPL_API_KEY" }
    // SS_TURNSTILE_SECRET_KEY deliberately NOT bound yet: the Turnstile widget's hostname is still the
    // `localhost` placeholder (prep manifest), so it cannot mint valid tokens on openvideotrans.xyz —
    // binding the secret would fail-CLOSE job creation (challenge_required). The gate stays fail-open
    // (bounded by the daily per-IP/global caps) until the owner points the widget at the live domain +
    // sets VITE_TURNSTILE_SITE_KEY; then add this binding back.
  ],
  // T2.5 queue_adapter (CF Queues) bindings are OMITTED at initial launch: `queueBackend` defaults to
  // `d1` (config.ts), so the D1 jobs table is the authoritative worklist and the worker long-polls
  // claim — the queue is only a latency-shaving overlay. CF Queues consumers additionally require the
  // Workers PAID plan; this deploy is on the free tier, so the producer/consumer bindings are left out
  // until the plan + the worker's queue subscription (deferred to M2-CLOSE/DEPLOY) are in place. The
  // Worker's queue() handler stays dormant with no consumer bound; selectProducer() returns the D1
  // no-op producer under queueBackend=d1. Re-add the "queues" block + flip queueBackend to cf_queues
  // (via CFG-GUARD) once on a paid plan.
  "vars": {
    // Non-secret defaults; the authoritative runtime values come from the settings table / KV
    // (CFG-GUARD owns validation). R2 account id + bucket are non-secret deploy vars.
    "R2_ACCOUNT_ID": "7dcd59cfc49c3458c870f5621dbf7263",
    "R2_BUCKET": "ovt-artifacts",
    // M2-CLOSE PR-B (#26): mark this deploy as production so the anon-identity surface fails CLOSED
    // (503) until ANON_ID_HMAC_KEY is injected — getActor accepts a raw id only under OVT_ENV='dev'.
    // ✅ SPA wiring landed (was the owner-confirmed 2026-06-29 GO-LIVE BLOCKER): apps/web now mints its
    // anon_id via POST /api/anon (ensureServerAnonId) and recovers from a rejected id (401) by
    // re-minting. DEPLOY must inject ANON_ID_HMAC_KEY (wrangler secret put) BEFORE opening public
    // traffic — until then prod actor routes stay fail-closed 503, which is the intended posture.
    "OVT_ENV": "prod"
  }
}
