{
  // Control-plane Cloudflare Worker — deploy config (T2.1). NOT used by the vitest gate; the real
  // resource ids + secrets are wired by the DEPLOY unit. NO SECRETS LIVE HERE: the R2 S3 presign
  // credentials (R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY) are `wrangler secret put`, and the free
  // provider keys are gated to the SECRETS unit — this file references binding/var NAMES only.
  "name": "ovt-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // DEPLOY (#28): the SAME Worker serves the SPA (same-origin — the posture App.svelte assumes; no
  // CORS surface, SameSite=Strict anon cookie stays first-party). Static requests are answered from
  // the built bundle; run_worker_first keeps the API + cron + queue paths in Worker code. Build the
  // SPA first (pnpm --filter @open-video-trans/web build) — wrangler uploads apps/web/dist verbatim.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  // T2.3 sweeper cadence. Every minute keeps lost-worker recovery latency under the 180s lease TTL;
  // the per-tick row cap (SWEEP_BATCH_LIMIT) bounds each run. Operational tuning is CFG-GUARD/DEPLOY's.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ovt-control-plane",
      "database_id": "0000-set-at-deploy",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ovt-media" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "0000-set-at-deploy" }],
  // T2.5 queue_adapter (CF Queues Free). The SAME Worker is producer (createJob emits a wake) and the
  // thin consumer (the `queue` handler reconciles the wake against the authoritative D1 worklist —
  // it never mutates job state). D1 stays the source of truth, so this is a latency-shaving overlay:
  // queueBackend defaults to `d1`; CFG-GUARD locks prod to cf_queues with an audited break-glass.
  // max_batch_timeout bounds wake latency; max_retries small because the D1 long-poll is the backstop.
  "queues": {
    "producers": [{ "binding": "JOB_QUEUE", "queue": "ovt-job-wake" }],
    "consumers": [
      { "queue": "ovt-job-wake", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  "vars": {
    // Non-secret defaults; the authoritative runtime values come from the settings table / KV
    // (CFG-GUARD owns validation). R2 account id + bucket are non-secret deploy vars.
    "R2_ACCOUNT_ID": "0000-set-at-deploy",
    "R2_BUCKET": "ovt-media",
    // M2-CLOSE PR-B (#26): mark this deploy as production so the anon-identity surface fails CLOSED
    // (503) until ANON_ID_HMAC_KEY is injected — getActor accepts a raw id only under OVT_ENV='dev'.
    // ⚠⚠ GO-LIVE BLOCKER (owner-confirmed 2026-06-29): do NOT inject ANON_ID_HMAC_KEY and do NOT enable
    // public production traffic until the web SPA is wired to mint a signed anon_id via POST /api/anon
    // (apps/web/T2.6 follow-up). Safety-wise this is fail-CLOSED, not unsafe: with the key set but the
    // SPA un-wired, prod browsers 401 (cannot run), and with no key prod actor routes 503 — neither
    // admits a forgeable identity. Go-live is gated on (key injected AND SPA wired) together.
    "OVT_ENV": "prod"
  }
}
